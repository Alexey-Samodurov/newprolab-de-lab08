    {
      "type": "timeseries",
      "id": 30,
      "title": "S3 requests & errors",
      "description": "RATE + ERRORS. Левая ось: rate(minio_s3_requests_total) by api. Правая ось: rate(minio_s3_requests_errors_total) красным. Когда errors появляются на фоне трафика — видно сразу.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (api) (rate(minio_s3_requests_total{job=\"minio\"}[1m]))",
          "refId": "A",
          "legendFormat": "req · {{api}}"
        },
        {
          "expr": "sum by (api) (rate(minio_s3_requests_errors_total{job=\"minio\"}[1m]))",
          "refId": "B",
          "legendFormat": "err · {{api}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
